{
  "name": "kdos-daniel-api",
  "private": true,
  "version": "2.0.0-rc.0",
  "description": "Kdos api for kdos daniel web app",
  "license": "MIT",
  "main": "index.js",
  "scripts": {
    "dev": "TS_NODE_FILES=true nodemon -V --exec 'node -r ts-node/register --inspect=0.0.0.0:10010 -- src/index.ts'",
    "build": "rm -rf dist/ && tsc && yarn run generate-openapi-documentation && cp openapi-documentation.json dist/ && cp package.json dist/ && cp yarn.lock dist/ && cp -r node_modules/ dist/ && cp -r mongodb-migration-scripts/ dist/",
    "start": "node dist/",
    "mongodb-migrate": "node dist/src/mongodb-migration.js",
    "mongodb-migrate:one-shot": "TS_NODE_FILES=true ts-node -- src/mongodb-migration.ts",
    "mongodb-migrate:docker": "node dist/mongodb-migration.js",
    "generate-openapi-documentation": "TS_NODE_FILES=true ts-node -- src/generate-openapi-documentation.ts",
    "generate-openapi-documentation-debug": "TS_NODE_FILES=true node -r ts-node/register --inspect-brk=0.0.0.0:10010 -- src/generate-openapi-documentation.ts",
    "format": "prettier --write '{,@(src|test|mongodb-migration-scripts)/**/}*.*'",
    "lint": "eslint",
    "lint:apply": "yarn run format && eslint --fix",
    "test": "echo 'no tests'",
    "rm:src": "find ./ -maxdepth 1 -mindepth 1 ! \\( -name 'dist' \\) -exec rm -rf {} \\;",
    "release": "export BABEL_DISABLE_CACHE=1 && release-it --ci",
    "release:dry": "export BABEL_DISABLE_CACHE=1 && release-it --ci --dry-run=true",
    "build:changelog": "conventional-changelog -i CHANGELOG.md -p eslint -r 0",
    "post:release": "echo Successfully released $npm_package_version",
    "docker:start": "docker compose up",
    "docker:mongodb-migrate:one-shot": "docker compose -f docker-compose-mongodb-migration-one-shot.yml up"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neo9/n9-node-microservice-skeleton.git"
  },
  "keywords": [
    "routing-controller",
    "express",
    "typescript"
  ],
  "engines": {
    "node": ">=26.0.0"
  },
  "author": "Benjamin DANIEL",
  "homepage": "https://github.com/neo9/n9-node-microservice-skeleton#n9-node-microservice-skeleton",
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@release-it/conventional-changelog": "^12.0.2",
    "@tsconfig/node26": "^26.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.6",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-eslint": "^6.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "release-it": "^21.1.2",
    "simple-git-hooks": "^2.14.0",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "@neo9/n9-mongodb-client": "^1.0.0",
    "@neo9/n9-mongodb-migration": "^1.0.0",
    "@neo9/n9-node-routing": "^3.0.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "0.5.1",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "source-map-support": "^0.5.21"
  },
  "simple-git-hooks": {
    "commit-msg": "yarn commitlint -e \"$@\"",
    "pre-commit": "yarn run format && yarn run lint"
  }
}
