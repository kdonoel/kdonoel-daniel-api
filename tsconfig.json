{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@tsconfig/node26/tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "emitDecoratorMetadata": true,
    "declaration": true,
    "experimentalDecorators": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "strict": false
  },
  "include": ["src"],
  "exclude": []
}
